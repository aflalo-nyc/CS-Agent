# Anthropic — required. Or run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# Shopify Admin API — read-only scopes only: read_orders, read_customers, read_inventory,
# plus read_products once the jewelry price lookup lands (see knowledge/JEWELRY_PRICING.md).
# Created via Settings -> Apps -> Develop apps -> Dev Dashboard (the old "private apps"
# flow was retired 2026-01-01). Leave blank to run on fixtures.
#
# Two ways to authenticate. Set whichever pair you have; config.get_shopify() picks.
#
#   A) Dev Dashboard app — SHOPIFY_API_KEY + SHOPIFY_API_SECRET (+ domain).
#      Exchanged for a 24h access token at run time via the client credentials grant and
#      re-minted automatically. App and store must be in the same Shopify organization.
#
#   B) Admin-created custom app — SHOPIFY_ADMIN_TOKEN (+ domain).
#      The shpat_ token, revealed once under Apps -> Develop apps -> app -> API credentials.
#      If set, this wins and nothing is exchanged.
#
# Note none of these are interchangeable: the client ID identifies the app, the client
# secret signs things, and only an shpat_ access token goes in X-Shopify-Access-Token.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# Gmail OAuth client. Scopes are pinned in gmail_client.py and deliberately exclude send.
GMAIL_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json

# Airtable — personal access token + base id for the one-way CS Drafts view.
AIRTABLE_TOKEN=
AIRTABLE_BASE=

AFLALO_DB=data/cs.db
