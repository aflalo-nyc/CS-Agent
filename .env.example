# ---- The brain's inputs (unchanged) ----
ANTHROPIC_API_KEY=
SHOPIFY_SHOP_DOMAIN=aflalo.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
AIRTABLE_TOKEN=
AIRTABLE_BASE=app86LogrXQQ1hno9

# ---- The service (aflalo_cs/service.py) ----
# The shared inbox, read over IMAP with a Gmail App Password (read-only import; the same
# password lets the button APPEND a draft to the Drafts folder and nothing else).
AFLALO_IMAP_USER=aflalo@aflalonyc.com
AFLALO_IMAP_PASSWORD=
# Where this service is reachable (Railway domain). Airtable's Open in Gmail links point here.
CS_PORTAL_URL=
# Random string. Signs the Open in Gmail links so a leaked link can't be edited into another message.
CS_LINK_SECRET=
# Minutes between cycles (import -> draft -> push). 0 = serve the button only.
CS_INTERVAL_MIN=10
# How far back the read-only import looks, and how many messages per folder per cycle.
CS_IMPORT_DAYS=30
CS_IMPORT_LIMIT=300
# Max new customer messages drafted per cycle.
CS_DRAFT_LIMIT=20
# Only customer messages received after this are drafted. Unset = the moment the service first started.
CS_GOLIVE_AT=
# SQLite path. On Railway this must be on a volume or dedup is lost on every redeploy.
AFLALO_DB=/data/cs.db
